{
  "api": {
    "services": ["HandlerService", "LoggerService", "StatsService", "RoutingService"],
    "tag": "api"
  },
  "log": {
    "access": "none",
    "dnsLog": false,
    "error": "",
    "loglevel": "warning",
    "maskAddress": "half"
  },
  "dns": {
    "tag": "dns-query",
    "queryStrategy": "UseIPv4",
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "skipFallback": false
      }
    ]
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 62789,
      "protocol": "tunnel",
      "settings": {
        "rewriteAddress": "127.0.0.1"
      },
      "tag": "api"
    }
  ],
  "outbounds": [
    {
      "tag": "exit-proxy",
      "protocol": "vless",
      "settings": {
        "address": {{ exit_public_ip | to_json }},
        "port": 443,
        "id": {{ exit_secrets.exit_transit_uuid | to_json }},
        "encryption": "none"
      },
      "streamSettings": {
        "method": "xhttp",
        "security": "reality",
        "realitySettings": {
          "serverName": {{ exit_secrets.exit_reality_target | to_json }},
          "fingerprint": "chrome",
          "password": {{ exit_secrets.exit_reality_public_key | to_json }},
          "shortId": {{ exit_secrets.exit_reality_short_id | to_json }},
          "spiderX": "/"
        },
        "xhttpSettings": {
          "path": {{ exit_secrets.exit_xhttp_path | to_json }},
          "mode": "auto"
        },
        "sockopt": {
          "domainStrategy": "UseIPv4",
          "tcpNoDelay": true
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "finalRules": [
          {
            "action": "block",
            "ip": ["geoip:private"]
          },
          {
            "action": "allow"
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4"
        }
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "policy": {
    "levels": {
      "0": {
        "statsUserDownlink": true,
        "statsUserUplink": true
      }
    },
    "system": {
      "statsInboundDownlink": true,
      "statsInboundUplink": true,
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "routing": {
    "domainStrategy": "IPOnDemand",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "inboundTag": ["dns-query"],
        "outboundTag": "exit-proxy"
      },
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      },
{% if block_quic %}
      {
        "type": "field",
        "network": "udp",
        "port": "443",
        "outboundTag": "blocked"
      },
{% endif %}
      {
        "type": "field",
        "domain": [{% for name in forced_exit_geosites %}{{ ('geosite:' ~ name) | to_json }}{% if not loop.last %}, {% endif %}{% endfor %}],
        "outboundTag": "exit-proxy"
      },
{% if additional_ru_direct_domains | length > 0 %}
      {
        "type": "field",
        "domain": [{% for name in additional_ru_direct_domains %}{{ ('domain:' ~ name) | to_json }}{% if not loop.last %}, {% endif %}{% endfor %}],
        "outboundTag": "direct"
      },
{% endif %}
      {
        "type": "field",
        "domain": ["geosite:category-ru"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": [{% for name in forced_exit_geoips %}{{ ('geoip:' ~ name) | to_json }}{% if not loop.last %}, {% endif %}{% endfor %}],
        "outboundTag": "exit-proxy"
      },
      {
        "type": "field",
        "ip": ["geoip:ru"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "exit-proxy"
      }
    ]
  },
  "stats": {},
  "metrics": {
    "listen": "127.0.0.1:11111",
    "tag": "metrics_out"
  }
}
